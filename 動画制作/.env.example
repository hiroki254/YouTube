# コピーして .env にし、値を入れる（.env は git に入れない）
GEMINI_API_KEY=

# 分析に使うモデル。Gemini 3.8 Flash のモデルID
GEMINI_MODEL=gemini-3.8-flash

# 考える深さ：low / medium / high（3.8 Flash は minimal 非対応）
GEMINI_THINKING_LEVEL=medium

# 動画を読み込む解像度：low / medium / high / 空欄（モデルの既定）
# 長い動画で入力トークンを節約したいときは low
GEMINI_MEDIA_RESOLUTION=
